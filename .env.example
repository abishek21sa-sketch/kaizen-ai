# KAIZEN AI V0.8.2 — never commit your real key.
# Copy this file to .env, add your key, then restart KAIZEN.
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # If both are set, the Google SDK gives GOOGLE_API_KEY precedence.

# Flash-Lite is the default because KAIZEN's deterministic engineering engines do the math;
# Gemini mainly orchestrates tools, explains evidence and challenges decisions.
GEMINI_MODEL=gemini-3.5-flash-lite

# On a 429 quota exhaustion, KAIZEN automatically tries the next model in this chain.
# Keep 3.5 Flash-Lite first; 3.1/2.5 Lite are compatibility fallbacks.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
